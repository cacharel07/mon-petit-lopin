DATABASE_URL=data/lopin.db
PHOTOS_DIR=data/photos
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- 'ton mot de passe'
ADMIN_PASSWORD_HASH=

# Max upload size (photos from the phone can weigh several MB)
BODY_SIZE_LIMIT=50M

# Automatic updates (scripts/auto-update.sh): restart the site through the alwaysdata API
# ALWAYSDATA_API_KEY=
# ALWAYSDATA_ACCOUNT=
# ALWAYSDATA_SITE_ID=
